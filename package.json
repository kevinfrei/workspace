{
  "name": "@freik/workspace",
  "version": "0.8.1",
  "module": "src/index.ts",
  "type": "module",
  "files": [
    "lib/*.js"
  ],
  "bin": {
    "tools": "lib/tools.js"
  },
  "devDependencies": {
    "@freik/typechk": "^0.9.3",
    "@types/bun": "^1.3.13",
    "@types/minimist": "^1.2.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "minimist": "^1.2.8",
    "typescript-eslint": "^8.59.1"
  },
  "peerDependencies": {
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "justtest": "bun test",
    "watch": "bun test --watch",
    "build": "bun build --outdir lib --external prettier --external typescript --external esbuild --target bun src/tools.ts",
    "dbgbuild": "bun build --outdir lib --external prettier --external typescript --external esbuild --target bun src/tools.ts",
    "format": "prettier --write *.json *.md src/**/*.ts src/**/*.json",
    "prepare": "husky",
    "prepublishOnly": "bun run build",
    "pub2npm": "npm publish --access public",
    "lint": "eslint --fix src",
    "typechk": "tsc --noEmit",
    "test": "bun run lint && bun run typechk && bun run justtest"
  },
  "engines": {
    "bun": ">1.0.22"
  },
  "dependencies": {
    "@freik/workspace": "^0.7.0"
  }
}
